# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL) - Prisma connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vinaphone_m2m

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Vinaphone Upstream API
VINAPHONE_API_BASE_URL=https://api.vinaphone.vn/m2m/v1
VINAPHONE_API_KEY=your_api_key_here
VINAPHONE_API_TIMEOUT_MS=10000

# Sync Schedule (cron expression - default every 10 minutes)
SYNC_CRON=*/10 * * * *

# Backup Email Cron
BACKUP_CRON=0 18 * * 1-6
BACKUP_TIMEZONE=Asia/Bangkok
BACKUP_EMAIL_TO=d9.fatm@gmail.com
BACKUP_ARTIFACT_PREFIX=vinaphone-backup
BACKUP_TEMP_DIRECTORY=

# SMTP (used for backup email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=yourname@gmail.com

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
